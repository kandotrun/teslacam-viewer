{
  "contract": "teslacam-viewer",
  "schemaVersion": 1,
  "module": "event-metadata",
  "source": [
    "apps/web/src/teslacam/event-metadata.ts",
    "apps/web/src/teslacam/scan-limits.ts"
  ],
  "cases": [
    {
      "name": "parse all known fields",
      "fn": "parseEventMetadata",
      "input": {
        "json": {
          "camera": "left_repeater",
          "city": "Sample city",
          "est_lat": "35.0000",
          "est_lon": "139.0000",
          "reason": "sentry_aware_object_detection",
          "street": "Sample street",
          "timestamp": "2026-08-21_14-30-45"
        }
      },
      "expected": {
        "metadata": {
          "camera": "left_repeater",
          "city": "Sample city",
          "est_lat": "35.0000",
          "est_lon": "139.0000",
          "reason": "sentry_aware_object_detection",
          "street": "Sample street",
          "timestamp": "2026-08-21_14-30-45"
        },
        "result": "ok"
      }
    },
    {
      "name": "parse timestamp only",
      "fn": "parseEventMetadata",
      "input": {
        "json": {
          "timestamp": "2026-08-20T20:35:30"
        }
      },
      "expected": {
        "metadata": {
          "timestamp": "2026-08-20T20:35:30"
        },
        "result": "ok"
      }
    },
    {
      "name": "parse unknown fields dropped",
      "fn": "parseEventMetadata",
      "input": {
        "json": {
          "nested": {
            "deep": [
              1,
              2
            ]
          },
          "timestamp": "2026-08-20T20:35:30",
          "untrusted_extra": "discarded"
        }
      },
      "expected": {
        "metadata": {
          "timestamp": "2026-08-20T20:35:30"
        },
        "result": "ok"
      }
    },
    {
      "name": "parse empty strings kept",
      "fn": "parseEventMetadata",
      "input": {
        "json": {
          "city": "",
          "reason": "",
          "timestamp": ""
        }
      },
      "expected": {
        "metadata": {
          "city": "",
          "reason": "",
          "timestamp": ""
        },
        "result": "ok"
      }
    },
    {
      "name": "parse null",
      "fn": "parseEventMetadata",
      "input": {
        "json": null
      },
      "expected": {
        "result": "invalid"
      }
    },
